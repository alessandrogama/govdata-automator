# ==============================================================================
# GovData Automator - n8n Environment Configuration Example
# Copy this file to '.env' in the same directory and adjust configuration.
# WARNING: Do not commit the actual '.env' containing real secrets to Git.
# ==============================================================================

# Port to expose n8n service on the host machine
N8N_PORT=5678

# Webhook URLs for notification channels (Discord or Slack)
# Leaving this empty will skip notifications gracefully in the workflow
NOTIFICATIONS_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# APIs Base URLs (if you want to override or point to testing environments)
BRASILAPI_BASE_URL=https://brasilapi.com.br/api
